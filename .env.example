# No private API credentials are needed. Never commit .env.
# Local backend (the Vite development proxy uses port 3001):
PORT=3001
HOST=127.0.0.1
# Render: set NODE_ENV=production, HOST=0.0.0.0; use Render-supplied PORT, not 3001.
# Production/Render defaults to 0.0.0.0 when HOST is omitted.
# Allow only the GitHub Pages origin (not a project path):
# ALLOWED_ORIGIN=https://building-with-ai-f26.github.io
# Public build configuration, not a secret. Set only after backend verification:
# VITE_API_ORIGIN=https://your-verified-backend.example

# Optional private-account feature; placeholders keep guest mode working.
# Copy only these lines into an existing .env; never overwrite existing settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Browser configuration is public. NEVER use a secret or service_role key here.
